# Betting Matrix — configuration optionnelle (sources gratuites uniquement)
# Copiez ce fichier vers .env si vous voulez personnaliser le comportement.
# Aucune cle API personnelle n'est necessaire.

# Cle publique de demonstration TheSportsDB (aucune inscription).
# Elle sert au calendrier partiel de la Ligue des Champions.
THESPORTSDB_KEY=123
THESPORTSDB_MIN_INTERVAL_MS=2000

# Fuseau utilise pour l'affichage des dates
APP_TIMEZONE=Europe/Paris

# Saisons gratuites disponibles (2026 = saison 2026-2027)
FREE_SEASONS=2026,2025

# Saison par defaut pour les classements et le modele
APP_DEFAULT_SEASON=2026

# Precharger le cache au demarrage (true/false)
AUTO_WARMUP=false
